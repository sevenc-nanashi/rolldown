```

## main.js

```js
import { n as imp1 } from "./imp.js";

//#region main.js
const load = async () => {
	console.log(await import("./imp.js").then((m) => m.imp1), await import("./imp.js").then((m) => m.imp2));
};
load();
console.log(`imp1: `, imp1);

//#endregion
```
